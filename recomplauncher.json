        {"label": "18 minutes", "set": {"hint_seconds": "1080"}},
        {"label": "19 minutes", "set": {"hint_seconds": "1140"}},
        {"label": "20 minutes", "set": {"hint_seconds": "1200"}},
        {"label": "21 minutes", "set": {"hint_seconds": "1260"}},
        {"label": "22 minutes", "set": {"hint_seconds": "1320"}},
        {"label": "23 minutes", "set": {"hint_seconds": "1380"}},
        {"label": "24 minutes", "set": {"hint_seconds": "1440"}},
        {"label": "25 minutes", "set": {"hint_seconds": "1500"}},
        {"label": "26 minutes", "set": {"hint_seconds": "1560"}},
        {"label": "27 minutes", "set": {"hint_seconds": "1620"}},
        {"label": "28 minutes", "set": {"hint_seconds": "1680"}},
        {"label": "29 minutes", "set": {"hint_seconds": "1740"}},
        {"label": "30 minutes", "set": {"hint_seconds": "1800"}}
      ],
      "defaults": {"hint_seconds": "0"}
    },
    {
      "id": "hint_on_l3",
      "label": "Show hint with left stick",
      "group": "Gameplay",
      "choices": [
        {"label": "Off", "set": {"hint_on_l3": "0"}},
        {"label": "On", "set": {"hint_on_l3": "1"}}
      ],
      "defaults": {"hint_on_l3": "1"}
    },
    {
      "id": "suit_colors",
      "label": "Suit colors",
      "group": "Suit",
      "help": "Samus' suit in other colors. Original is the game's; Custom uses the helmet, armor and body colors below. Made from your own game files as the suit loads.",
      "choices": [
        {"label": "Original", "set": {"suit_colors": "original"}},
        {"label": "Custom", "set": {"suit_colors": "custom"}}
      ],
      "defaults": {"suit_colors": "original"}
    },
    {
      "id": "suit_helmet",
      "label": "Helmet",
      "group": "Suit",
      "help": "The helmet's shell, the brow over the visor and the bulbs at its sides.",
      "choices": [
        {"label": "Red", "set": {"suit_helmet": "red"}},
        {"label": "Crimson", "set": {"suit_helmet": "crimson"}},
        {"label": "Orange", "set": {"suit_helmet": "orange"}},
        {"label": "Gold", "set": {"suit_helmet": "gold"}},
        {"label": "Yellow", "set": {"suit_helmet": "yellow"}},
        {"label": "Lime", "set": {"suit_helmet": "lime"}},
        {"label": "Green", "set": {"suit_helmet": "green"}},
        {"label": "Teal", "set": {"suit_helmet": "teal"}},
        {"label": "Cyan", "set": {"suit_helmet": "cyan"}},
        {"label": "Sky blue", "set": {"suit_helmet": "sky blue"}},
        {"label": "Blue", "set": {"suit_helmet": "blue"}},
        {"label": "Navy", "set": {"suit_helmet": "navy"}},
        {"label": "Purple", "set": {"suit_helmet": "purple"}},
        {"label": "Magenta", "set": {"suit_helmet": "magenta"}},
        {"label": "Pink", "set": {"suit_helmet": "pink"}},
