      "help": "The rest of the suit: the arms and legs and the Varia Suit's shoulders.",
      "choices": [
        {"label": "Red", "set": {"suit_body": "red"}},
        {"label": "Crimson", "set": {"suit_body": "crimson"}},
        {"label": "Orange", "set": {"suit_body": "orange"}},
        {"label": "Gold", "set": {"suit_body": "gold"}},
