        {"label": "Teal", "set": {"suit_body": "teal"}},
        {"label": "Cyan", "set": {"suit_body": "cyan"}},
        {"label": "Sky blue", "set": {"suit_body": "sky blue"}},
        {"label": "Blue", "set": {"suit_body": "blue"}},
        {"label": "Navy", "set": {"suit_body": "navy"}},
        {"label": "Purple", "set": {"suit_body": "purple"}},
        {"label": "Magenta", "set": {"suit_body": "magenta"}},
        {"label": "Pink", "set": {"suit_body": "pink"}},
        {"label": "White", "set": {"suit_body": "white"}},
